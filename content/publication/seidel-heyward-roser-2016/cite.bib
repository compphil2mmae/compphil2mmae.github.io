  author = {Seidel, Christian},
  title = {The Costs of Moralizing. How About a 'Government House Climate Ethics'?},
  year = {2016},
  booktitle = {Climate Justice in a Non-Ideal World},
  editor = {Heyward, Clare and Roser, Dominic},
  pages = {277--295},
